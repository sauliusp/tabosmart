[
  {
    "start": 0.0,
    "end": 1.82,
    "text": "You didn't open all those tabs for no reason."
  },
  {
    "start": 2.2,
    "end": 3.42,
    "text": "You just don't need them all right now."
  },
  {
    "start": 3.84,
    "end": 4.98,
    "text": "Bring related work together."
  },
  {
    "start": 5.46,
    "end": 7.72,
    "text": "Review repeat pages, save links for later."
  },
  {
    "start": 8.3,
    "end": 9.48,
    "text": "Close only what you choose."
  },
  {
    "start": 10.16,
    "end": 13.54,
    "text": "Recovery reopens URLs, not unsaved edits."
  },
  {
    "start": 14.16,
    "end": 16.1,
    "text": "Your browsing data stays on your device."
  },
  {
    "start": 16.88,
    "end": 20.66,
    "text": "Optional local AI adds suggestions and group names on"
  },
  {
    "start": 20.66,
    "end": 22.02,
    "text": "supported Chrome devices."
  },
  {
    "start": 22.36,
    "end": 23.52,
    "text": "The core works without it."
  },
  {
    "start": 23.84,
    "end": 25.46,
    "text": "I'm building this with the people using it."
  },
  {
    "start": 25.86,
    "end": 27.88,
    "text": "Tell me what missed the point or what would"
  },
  {
    "start": 27.88,
    "end": 28.92,
    "text": "make it useful tomorrow."
  },
  {
    "start": 28.92,
    "end": 31.18,
